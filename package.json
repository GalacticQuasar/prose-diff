{
  "name": "prose-diff",
  "version": "0.2.0",
  "description": "Review and merge changes to prose word by word: a web app, and a CLI for edits to a file on disk (by hand or by an AI agent).",
  "keywords": [
    "diff",
    "merge",
    "prose",
    "writing",
    "review",
    "cli",
    "claude-code",
    "word-diff"
  ],
  "homepage": "https://prose-diff.vercel.app",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/GalacticQuasar/prose-diff.git"
  },
  "bugs": {
    "url": "https://github.com/GalacticQuasar/prose-diff/issues"
  },
  "license": "MIT",
  "author": "GalacticQuasar",
  "type": "module",
  "bin": {
    "prose-diff": "dist-cli/prose-diff.js"
  },
  "files": [
    "dist",
    "dist-cli"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc && tsc -p tsconfig.cli.json && vite build && tsc -p tsconfig.cli.build.json",
    "preview": "vite preview",
    "test": "vitest run",
    "prepublishOnly": "npm test && npm run build"
  },
  "devDependencies": {
    "@fontsource/courier-prime": "^5.3.0",
    "@types/node": "^24.19.2",
    "diff": "^9.0.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.3"
  }
}
